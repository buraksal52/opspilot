# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
APP_ENV=development
APP_NAME=OpsPilot

# --- PostgreSQL (apps/api) ---
# SQLAlchemy async engine (ADR-020), asyncpg driver.
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication (ADR-019) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
